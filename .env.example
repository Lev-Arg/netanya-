# NETANYA_SECRET: Server-side secret for HMAC session tokens and AES-256-GCM PHI encryption.
# Optional in development (auto-generated into ./data/.runtime-secret); set a strong 32+ char secret in production.
NETANYA_SECRET="replace-with-strong-32-byte-secret"

# DB_PATH: Path to embedded SQLite database file (defaults to ./data/netanya_pharmacy.db).
DB_PATH="./data/netanya_pharmacy.db"

# Test portal accounts — provisioned on boot for any role with both EMAIL and PASSWORD set.
# PASSWORD must be at least 12 characters. NAME is optional (defaults shown).
# Development/test use only — do NOT set these in production.
TEST_PATIENT_EMAIL=""
TEST_PATIENT_PASSWORD=""
TEST_PATIENT_NAME="Test Patient"

TEST_PHARMACIST_EMAIL=""
TEST_PHARMACIST_PASSWORD=""
TEST_PHARMACIST_NAME="Test Pharmacist"

TEST_OWNER_EMAIL=""
TEST_OWNER_PASSWORD=""
TEST_OWNER_NAME="Test Owner"

TEST_SUPPLIER_EMAIL=""
TEST_SUPPLIER_PASSWORD=""
TEST_SUPPLIER_NAME="Test Supplier"
