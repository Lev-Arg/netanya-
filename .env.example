# NETANYA_SECRET: Server-side secret for HMAC session tokens and AES-256-GCM PHI encryption.
# Optional in development (auto-generated into ./data/.runtime-secret); set a strong 32+ char secret in production.
NETANYA_SECRET="replace-with-strong-32-byte-secret"

# DB_PATH: Path to embedded SQLite database file (defaults to ./data/netanya_pharmacy.db).
DB_PATH="./data/netanya_pharmacy.db"
